<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="Previous page"
            android:gravity="center"
            android:text="&#8249;"
            android:textColor="#7D9CFF"
            android:textSize="30sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="#F2B23C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#9BA6C7"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="Next page"
            android:gravity="center"
            android:text="&#8250;"
            android:textColor="#7D9CFF"
            android:textSize="30sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/sched"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Weekly schedule"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/text_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

        <TextView
            android:id="@+id/l1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#C9D2EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/l2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#C9D2EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/l3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#C9D2EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/l4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#C9D2EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/l5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#C9D2EE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/l6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#C9D2EE"
            android:textSize="13sp" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
